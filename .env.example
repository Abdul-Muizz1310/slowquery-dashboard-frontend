# ---------------------------------------------------------------------------
# slowquery-dashboard-frontend — environment variables
# ---------------------------------------------------------------------------
# Every NEXT_PUBLIC_* variable is parsed at boot by `src/lib/env.ts` (added
# in S4). Missing values throw at import time so misconfigured builds fail
# fast rather than producing a half-broken dashboard in production.

# --- Backend ---------------------------------------------------------------
# Base URL of the slowquery-demo-backend Render service. The server calls it
# directly (signed); the browser never does: it goes through /api/backend.
NEXT_PUBLIC_API_URL=https://slowquery-demo-backend.onrender.com

# --- Platform token (server-only; docs/specs/07-backend-proxy.md) ----------
# Ed25519 private key, PKCS#8 DER, base64. The server signs every backend call
# with it (iss "slowquery-frontend", aud "slowquery", 60 s); the backend holds
# the public half as SLOWQUERY_FRONTEND_SIGNING_KEY_PUBLIC. Never NEXT_PUBLIC_.
# Without it the proxy answers 503 and the pages show their error state.
SLOWQUERY_FRONTEND_SIGNING_KEY_PRIVATE=

# --- Site ------------------------------------------------------------------
# Absolute origin this deployment serves itself on. Used by Playwright and
# by Next.js for absolute URL generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
